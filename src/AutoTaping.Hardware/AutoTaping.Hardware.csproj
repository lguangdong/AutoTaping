<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AutoTaping.Core\AutoTaping.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 海康 MVS SDK（MvCameraControl.Net）为可选依赖：探测到 .NET 封装 dll 时才编译真实相机实现（HAS_MVS）。
       探测逻辑（路径候选、优先级）在仓库根目录的 Directory.Build.props 里，结果放在 $(MvsNetDll)。
       找不到时编译 HikvisionCamera 的占位实现（降级 Virtual + AL201），工程照常可编译可运行。
       机型无关：MV-CA060 系列等 MVS 4.x/5.x 支持的机型共用同一套调用。
       注意：原生库（MvCameraControl.dll 等）由 MVS 安装程序写入 PATH，不在本工程复制。 -->
  <PropertyGroup Condition="'$(MvsNetDll)' != ''">
    <DefineConstants>$(DefineConstants);HAS_MVS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(MvsNetDll)' != ''">
    <Reference Include="MvCameraControl.Net">
      <HintPath>$(MvsNetDll)</HintPath>
      <!-- 复制到输出目录，运行时不需要开发机能访问原路径 -->
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 雷赛运控卡原生库（可选）：把 LTDMC.dll 放进 libs/ 后自动复制到输出目录（含 App 的输出）。
       它是**原生**库，不能用 <Reference>（<Reference> 是托管程序集专用）；
       LeadshineApi 里是 [DllImport("LTDMC.dll")] 裸文件名，只要出现在 exe 同级目录就会被找到。
       位数必须与进程一致：本程序跟相机一起走 x64，所以需要雷赛的 **x64 版** LTDMC.dll，
       32 位 dll 会抛 BadImageFormatException → 运控卡降级 Virtual + AL105。 -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)libs\LTDMC.dll')">
    <None Include="$(MSBuildThisFileDirectory)libs\LTDMC*.dll"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!-- 编译时打印实际选用的 MVS 封装与雷赛原生库，便于确认接入状态 -->
  <Target Name="ReportMvsSdk" BeforeTargets="CoreCompile">
    <Message Importance="high" Condition="'$(MvsNetDll)' != ''" Text="海康 MVS: 使用 $(MvsNetDll)（HAS_MVS 已启用）" />
    <Message Importance="high" Condition="'$(MvsNetDll)' == ''" Text="海康 MVS: 未找到 MvCameraControl.Net.dll，编译占位相机实现（降级 Virtual）" />
    <Message Importance="high" Condition="Exists('$(MSBuildThisFileDirectory)libs\LTDMC.dll')" Text="雷赛运控卡: libs\LTDMC.dll 将复制到输出目录" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 版本号与主窗口标题一致：v1.0.0（见 11-开发任务分解 S0 验收标准 2） -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- MVVM：README 第 3 节锁定的轻量框架（Source Generator，不引入重框架） -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <!-- 调试用：把日志同时写 VS「输出 → 调试」窗口（需调试器附加；独立运行时以文件日志为准） -->
    <PackageReference Include="Serilog.Sinks.Debug" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoTaping.Core\AutoTaping.Core.csproj" />
    <ProjectReference Include="..\AutoTaping.Hardware\AutoTaping.Hardware.csproj" />
    <ProjectReference Include="..\AutoTaping.Vision\AutoTaping.Vision.csproj" />
    <ProjectReference Include="..\AutoTaping.Data\AutoTaping.Data.csproj" />
  </ItemGroup>

  <!-- 海康 MVS 托管封装：这里必须再登记一次引用（$(MvsNetDll) 由根目录 Directory.Build.props 探测）。
       不登记的话：dll 虽然被 Hardware 复制到了输出目录，但 AutoTaping.App.deps.json 里没有这条，
       .NET Core 只按 deps.json 建 TPA 列表解析程序集 → 运行时报
       FileNotFoundException: Could not load file or assembly 'MvCameraControl.Net' → 相机降级 Virtual。 -->
  <ItemGroup Condition="'$(MvsNetDll)' != ''">
    <Reference Include="MvCameraControl.Net">
      <HintPath>$(MvsNetDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 配置文件必须随可执行文件一起输出，否则启动时读不到（LogPath / 轴参数 / IO 映射都来自这里） -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- 虚拟相机样本图：tools/SampleGen 生成后复制到输出目录 images/samples（源目录为空时不复制） -->
    <None Include="..\..\tools\SampleGen\sample\*.png"
          Link="images\samples\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

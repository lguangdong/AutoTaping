<!--
    职责：主窗口壳——① 状态栏 + ② 导航栏 + ③ 内容区 + ④ 操作条（布局见 07-UI设计规范 第 5.1 节）
    层：App/Views
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、ViewModels、Views/Pages（颜色/字号/尺寸全部引用资源字典）
-->
<Window x:Class="AutoTaping.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AutoTaping.App.Converters"
        xmlns:pages="clr-namespace:AutoTaping.App.Views.Pages"
        xmlns:vm="clr-namespace:AutoTaping.App.ViewModels"
        Title="自动贴胶机上位机 v1.0.0"
        Width="{StaticResource MainWindowWidth}"
        Height="{StaticResource MainWindowHeight}"
        MinWidth="{StaticResource MainWindowMinWidth}"
        MinHeight="{StaticResource MainWindowMinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        Foreground="{StaticResource TextPrimary}">

    <Window.Resources>
        <converters:DeviceStateToBrushConverter x:Key="DeviceStateToBrush" />

        <!-- 页面 ViewModel → 页面 View 的映射：内容区只绑定 CurrentPage，切页由这里决定渲染哪个 Page -->
        <DataTemplate DataType="{x:Type vm:AutoViewModel}">
            <pages:AutoPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManualViewModel}">
            <pages:ManualPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecipeViewModel}">
            <pages:RecipePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VisionViewModel}">
            <pages:VisionPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlarmViewModel}">
            <pages:AlarmPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OutputViewModel}">
            <pages:OutputPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IoViewModel}">
            <pages:IoPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <pages:SystemPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource StatusBarRowHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource OperationBarRowHeight}" />
        </Grid.RowDefinitions>

        <!-- ===================== ① 状态栏 ===================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 状态灯（颜色随设备状态变，07-UI设计规范 第 6 节） -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Ellipse Width="{StaticResource StatusLampSize}"
                             Height="{StaticResource StatusLampSize}"
                             Fill="{Binding CurrentState, Converter={StaticResource DeviceStateToBrush}}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DeviceStateText}" Style="{StaticResource StatusValueText}" FontWeight="Bold" />
                </StackPanel>

                <!-- 当前配方 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="配方" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding RecipeName}"
                               Style="{StaticResource StatusValueText}"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 产量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="产量" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding OutputText}" Style="{StaticResource StatusValueText}" />
                </StackPanel>

                <!-- 良率 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="良率" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding YieldText}" Style="{StaticResource StatusValueText}" />
                </StackPanel>

                <!-- 未确认报警数（红底白字，点击跳报警页） -->
                <Button Grid.Column="4"
                        Style="{StaticResource AlarmBadgeButton}"
                        Content="{Binding AlarmBadgeText}"
                        Command="{Binding ShowAlarmsCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,24,0" />

                <!-- 当前用户 + 角色 -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="用户" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding CurrentUserText}" Style="{StaticResource StatusValueText}" />
                </StackPanel>

                <!-- 系统时间（每秒刷新） -->
                <TextBlock Grid.Column="6"
                           Text="{Binding ClockText}"
                           Style="{StaticResource StatusValueText}"
                           FontFamily="{StaticResource FontFamilyNumeric}"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ===================== ② 导航栏 + ③ 内容区 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource NavColumnWidth}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderNormal}"
                    BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding NavigationItems}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding SelectCommand}"
                                    Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ===================== ④ 操作条 ===================== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderNormal}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="启 动"
                        Style="{StaticResource PrimaryButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding StartCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                <Button Grid.Column="1"
                        Content="暂 停"
                        Style="{StaticResource NormalButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding PauseCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                <Button Grid.Column="2"
                        Content="停 止"
                        Style="{StaticResource DangerButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding StopCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                <Button Grid.Column="3"
                        Content="复 位"
                        Style="{StaticResource NormalButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding ResetCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                <Button Grid.Column="4"
                        Content="{Binding EmergencyStopText}"
                        Style="{StaticResource DangerButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding EmergencyStopCommand}"
                        VerticalAlignment="Center"
                        Margin="0,0,16,0" />
                <Button Grid.Column="5"
                        Content="{Binding SingleStepText}"
                        Style="{StaticResource NormalButton}"
                        Height="{StaticResource ButtonPrimaryMinHeight}"
                        Command="{Binding ToggleSingleStepCommand}"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="节拍" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding CycleTimeText}"
                               Style="{StaticResource NumericText}"
                               Margin="8,0,24,0" />
                    <Ellipse Width="{StaticResource StatusLampSize}"
                             Height="{StaticResource StatusLampSize}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEStopped}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource StatusAlarm}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EmergencyStopStatusText}" Style="{StaticResource StatusValueText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

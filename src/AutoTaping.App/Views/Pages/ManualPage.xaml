<!--
    职责：手动调试页——红色安全横幅 + 4 轴面板（2×2）+ 只读 IO 网格 + 气缸/真空/吹气/压合控制
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、PressHoldBehavior、ManualViewModel
    说明：布局按 08-页面清单 页面 2；颜色/字号/尺寸全部引用资源字典，禁止字面值
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.ManualPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AutoTaping.App.Behaviors"
             Background="{StaticResource BgMain}">
    <Grid Margin="{StaticResource SpacingMedium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 永久红色安全横幅（08-页面清单 页面 2：不可关闭） ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource StatusAlarm}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="⚠ 手动模式：设备内可能有人，操作前请确认安全！"
                           FontWeight="Bold"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Content="退出手动"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding LeavePageCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="480" />
            </Grid.ColumnDefinitions>

            <!-- ===== 4 轴控制（2×2） ===== -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Axes}" Margin="0,0,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,0,8,8">
                            <StackPanel>
                                <!-- 轴名 + 当前位置 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AxisName}"
                                               Style="{StaticResource GroupTitleText}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Position, StringFormat={}{0:F2}}"
                                               Style="{StaticResource NumericText}"
                                               Margin="16,0,0,0" />
                                    <TextBlock Text="{Binding Unit}"
                                               Style="{StaticResource UnitText}"
                                               VerticalAlignment="Bottom"
                                               Margin="8,0,0,4" />
                                </StackPanel>

                                <!-- 点动（按住才动，松开立即停） + 回零（二次确认） -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="◄◄"
                                            Style="{StaticResource SmallButton}"
                                            behaviors:PressHoldBehavior.PressCommand="{Binding JogNegativeCommand}"
                                            behaviors:PressHoldBehavior.ReleaseCommand="{Binding StopJogCommand}" />
                                    <Button Content="回 零"
                                            Style="{StaticResource SmallButton}"
                                            Margin="8,0"
                                            Command="{Binding HomeCommand}" />
                                    <Button Content="►►"
                                            Style="{StaticResource SmallButton}"
                                            behaviors:PressHoldBehavior.PressCommand="{Binding JogPositiveCommand}"
                                            behaviors:PressHoldBehavior.ReleaseCommand="{Binding StopJogCommand}" />
                                </StackPanel>

                                <!-- 速度 -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="速度"
                                               Style="{StaticResource StatusLabelText}"
                                               MinWidth="48" />
                                    <TextBox Style="{StaticResource NumericInputBox}"
                                             Width="96"
                                             Text="{Binding SpeedText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding SpeedUnit}"
                                               Style="{StaticResource UnitText}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding SpeedError}"
                                           Style="{StaticResource HintText}"
                                           Foreground="{StaticResource StatusAlarm}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasSpeedError, Converter={StaticResource BoolToVisibility}}" />

                                <!-- 目标位置 + 定位（超软限位时红框 + 按钮禁用） -->
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="目标"
                                               Style="{StaticResource StatusLabelText}"
                                               MinWidth="48" />
                                    <TextBox Style="{StaticResource TargetInputBox}"
                                             Width="118"
                                             Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="定 位"
                                            Style="{StaticResource SmallButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding MoveToTargetCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TargetError}"
                                           Style="{StaticResource HintText}"
                                           Foreground="{StaticResource StatusAlarm}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasTargetError, Converter={StaticResource BoolToVisibility}}" />

                                <!-- 软限位与轴状态 -->
                                <TextBlock Text="{Binding LimitText, StringFormat={}软限位 {0}}"
                                           Style="{StaticResource HintText}"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding StateText}" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 右侧：IO 只读网格 + 气缸/阀控制 ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8">
                    <StackPanel>
                        <TextBlock Text="输入 DI（只读）" Style="{StaticResource GroupTitleText}" />
                        <ItemsControl ItemsSource="{Binding DiPoints}"
                                      ItemTemplate="{StaticResource IoPointTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="输出 DO" Style="{StaticResource GroupTitleText}" />
                        <ItemsControl ItemsSource="{Binding DoPoints}"
                                      ItemTemplate="{StaticResource IoPointTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,16,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="气缸 / 阀控制" Style="{StaticResource GroupTitleText}" />

                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Content="真空 开" Style="{StaticResource SmallButton}" Margin="0,0,8,8"
                                    Command="{Binding VacuumOnCommand}" />
                            <Button Content="真空 关" Style="{StaticResource SmallButton}" Margin="0,0,0,8"
                                    Command="{Binding VacuumOffCommand}" />
                            <Button Content="吹气 开" Style="{StaticResource SmallButton}" Margin="0,0,8,8"
                                    Command="{Binding BlowOnCommand}" />
                            <Button Content="吹气 关" Style="{StaticResource SmallButton}" Margin="0,0,0,8"
                                    Command="{Binding BlowOffCommand}" />
                            <Button Content="压合 下压" Style="{StaticResource SmallButton}" Margin="0,0,8,0"
                                    Command="{Binding PressDownCommand}" />
                            <Button Content="压合 抬起" Style="{StaticResource SmallButton}"
                                    Command="{Binding PressUpCommand}" />
                        </UniformGrid>

                        <TextBlock Text="急停中：本页所有控制已禁用，请排除危险后由工程师复位。"
                                   Style="{StaticResource HintText}"
                                   Foreground="{StaticResource StatusAlarm}"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding IsEmergencyStopped, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="IO 强制输出仅工程师可在「IO 监控」页执行。"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

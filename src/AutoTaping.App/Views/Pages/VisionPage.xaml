<!--
    职责：视觉标定页——单次拍照（叠加 MARK 十字与 ROI 框）+ 手动识别 + 九点标定向导 + 模板制作
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、VisionViewModel
    说明：布局按 08-页面清单 页面 4；颜色/字号/尺寸全部引用资源字典，禁止字面值；
          预览图用 Viewbox + Canvas 叠加，叠加坐标用图像像素坐标（Viewbox 自动缩放）
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.VisionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgMain}">
    <Grid Margin="{StaticResource SpacingMedium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitleText}" />

        <TabControl Grid.Row="1" Margin="0,16,0,0"
                    Background="{StaticResource BgMain}"
                    BorderBrush="{StaticResource BorderNormal}">
            <!-- ==================== Tab 1：拍照识别 ==================== -->
            <TabItem Header="拍照识别">
                <Grid Margin="{StaticResource SpacingMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 相机设置栏 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Ellipse Width="{StaticResource StatusLampSize}"
                                     Height="{StaticResource StatusLampSize}"
                                     VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCameraConnected}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="相机"
                                       Style="{StaticResource StatusLabelText}" />
                            <TextBlock Text="{Binding CameraStatusText}"
                                       Style="{StaticResource StatusValueText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="曝光" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource NumericInputBox}" Width="96" Margin="8,0"
                                     Text="{Binding Exposure, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="μs" Style="{StaticResource UnitText}" VerticalAlignment="Center" />
                            <TextBlock Text="增益" Style="{StaticResource StatusLabelText}"
                                       VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox Style="{StaticResource NumericInputBox}" Width="80"
                                     Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="dB" Style="{StaticResource UnitText}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                            <Button Content="应 用" Style="{StaticResource SmallButton}"
                                    Margin="16,0,0,0"
                                    Command="{Binding ApplyCameraSettingsCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 预览图 + 识别结果 -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：图像显示（Viewbox 自动缩放，Canvas 叠加 MARK 与 ROI）+ 图例条 -->
                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                            <Viewbox Grid.Row="0" Stretch="Uniform">
                                <Grid Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                                    <Image Source="{Binding PreviewImage}" Stretch="Fill" />
                                    <Canvas Background="Transparent"
                                            MouseLeftButtonDown="OnPreviewMouseDown"
                                            MouseMove="OnPreviewMouseMove"
                                            MouseLeftButtonUp="OnPreviewMouseUp">

                                        <!-- 两个 MARK 共用的搜索区域（ROI）：只在这块范围内查找 MARK -->
                                        <Rectangle Canvas.Left="{Binding SearchRoiX}"
                                                   Canvas.Top="{Binding SearchRoiY}"
                                                   Width="{Binding SearchRoiW}"
                                                   Height="{Binding SearchRoiH}"
                                                   Stroke="{StaticResource StatusWait}"
                                                   StrokeThickness="2" />

                                        <!-- ROI 名称标签：贴在框左上角内侧，深色底保证灰度图上可读 -->
                                        <Border Canvas.Left="{Binding SearchRoiX}"
                                                Canvas.Top="{Binding SearchRoiY}"
                                                Background="{StaticResource BgMain}"
                                                Opacity="0.8"
                                                CornerRadius="{StaticResource ControlCornerRadius}"
                                                Padding="6,2">
                                            <TextBlock Text="搜索区域 ROI"
                                                       Foreground="{StaticResource StatusWait}"
                                                       FontSize="{StaticResource FontSizeUnit}" />
                                        </Border>

                                        <!-- MARK1 十字（识别结果） -->
                                        <Path Data="M -20,0 L 20,0 M 0,-20 L 0,20"
                                              Stroke="{StaticResource StatusRun}"
                                              StrokeThickness="2"
                                              Visibility="{Binding Mark1Found, Converter={StaticResource BoolToVisibility}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="{Binding Mark1X}" Y="{Binding Mark1Y}" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- MARK2 十字 -->
                                        <Path Data="M -20,0 L 20,0 M 0,-20 L 0,20"
                                              Stroke="{StaticResource StatusRun}"
                                              StrokeThickness="2"
                                              Visibility="{Binding Mark2Found, Converter={StaticResource BoolToVisibility}}">
                                            <Path.RenderTransform>
                                                <TranslateTransform X="{Binding Mark2X}" Y="{Binding Mark2Y}" />
                                            </Path.RenderTransform>
                                        </Path>

                                        <!-- 框选 ROI（模板制作） -->
                                        <Rectangle Canvas.Left="{Binding SelectedRoiX}"
                                                   Canvas.Top="{Binding SelectedRoiY}"
                                                   Width="{Binding SelectedRoiW}"
                                                   Height="{Binding SelectedRoiH}"
                                                   Stroke="{StaticResource StatusInfo}"
                                                   StrokeThickness="2"
                                                   StrokeDashArray="4,3"
                                                   Visibility="{Binding HasSelectedRoi, Converter={StaticResource BoolToVisibility}}" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>

                                <!-- 图例：黄框=搜索区域，绿十字=识别到的 MARK，蓝虚线=框选（裁模板用） -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Rectangle Width="24" Height="16"
                                               Stroke="{StaticResource StatusWait}" StrokeThickness="2"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="搜索区域"
                                               Style="{StaticResource HintText}"
                                               Margin="8,0,24,0" VerticalAlignment="Center" />

                                    <Path Data="M -10,0 L 10,0 M 0,-10 L 0,10"
                                          Width="24" Height="16" Stretch="Uniform"
                                          Stroke="{StaticResource StatusRun}" StrokeThickness="2"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="识别到的 MARK 中心"
                                               Style="{StaticResource HintText}"
                                               Margin="8,0,24,0" VerticalAlignment="Center" />

                                    <Rectangle Width="24" Height="16"
                                               Stroke="{StaticResource StatusInfo}" StrokeThickness="2"
                                               StrokeDashArray="4,3"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="框选（仅裁模板用）"
                                               Style="{StaticResource HintText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右：识别结果（面板较多，窗口高度不足时可滚动） -->
                        <ScrollViewer Grid.Column="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <Border Style="{StaticResource PanelBorder}">
                                <StackPanel>
                                    <TextBlock Text="识别结果" Style="{StaticResource GroupTitleText}" />

                                    <TextBlock Text="{Binding Mark1Text}" Style="{StaticResource StatusValueText}" Margin="0,16,0,0" />
                                    <TextBlock Text="{Binding Mark2Text}" Style="{StaticResource StatusValueText}" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="匹配分" Style="{StaticResource StatusLabelText}" />
                                        <TextBlock Text="{Binding MatchScoreText}" Style="{StaticResource StatusValueText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="角度" Style="{StaticResource StatusLabelText}" />
                                        <TextBlock Text="{Binding AngleText}" Style="{StaticResource StatusValueText}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeltaText}"
                                               Style="{StaticResource StatusValueText}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="模板制作" Style="{StaticResource GroupTitleText}" />
                                    <TextBlock Text="先拍照，再在图上框选 MARK 区域后保存"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <UniformGrid Columns="1" Margin="0,8,0,0">
                                        <Button Content="保存 MARK1 模板" Style="{StaticResource SmallButton}"
                                                Margin="0,0,0,8" Command="{Binding SaveMark1TemplateCommand}" />
                                        <Button Content="保存 MARK2 模板" Style="{StaticResource SmallButton}"
                                                Command="{Binding SaveMark2TemplateCommand}" />
                                    </UniformGrid>
                                    <TextBlock Text="框选只用于裁剪模板，不会改动搜索区域"
                                               Style="{StaticResource HintText}"
                                               Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部：操作按钮 + 状态 -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="拍 照" Style="{StaticResource NormalButton}"
                                    MinHeight="{StaticResource ButtonPrimaryMinHeight}"
                                    Command="{Binding TakePhotoCommand}" />
                            <Button Content="识 别" Style="{StaticResource PrimaryButton}"
                                    Margin="12,0,0,0"
                                    Command="{Binding RecognizeCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding PreviewStatus}"
                                   Style="{StaticResource StatusValueText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ==================== Tab 2：九点标定 ==================== -->
            <TabItem Header="九点标定">
                <Grid Margin="{StaticResource SpacingMedium}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标定输入 + 操作按钮 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="标定区域中心" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="X" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" Margin="8,0,8,0" />
                            <TextBox Style="{StaticResource NumericInputBox}" Width="96"
                                     Text="{Binding CalibrationCenterX, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Y" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox Style="{StaticResource NumericInputBox}" Width="96"
                                     Text="{Binding CalibrationCenterY, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="步长(mm)" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" Margin="16,0,8,0" />
                            <TextBox Style="{StaticResource NumericInputBox}" Width="96"
                                     Text="{Binding CalibrationStep, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="开始标定" Style="{StaticResource NormalButton}"
                                    Command="{Binding StartCalibrationCommand}" />
                            <Button Content="停 止" Style="{StaticResource DangerButton}"
                                    MinWidth="{StaticResource ButtonSmallMinWidth}"
                                    Margin="8,0,0,0"
                                    Command="{Binding StopCalibrationCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- 进度 -->
                    <TextBlock Grid.Row="1" Text="{Binding CalibrationProgress, StringFormat={}进度：{0}}"
                               Style="{StaticResource StatusValueText}" Margin="0,16,0,0" />

                    <!-- 残差表 -->
                    <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" Style="{StaticResource StatusLabelText}" />
                                <TextBlock Grid.Column="1" Text="平台X(mm)" Style="{StaticResource StatusLabelText}" />
                                <TextBlock Grid.Column="2" Text="平台Y(mm)" Style="{StaticResource StatusLabelText}" />
                                <TextBlock Grid.Column="3" Text="像素U" Style="{StaticResource StatusLabelText}" />
                                <TextBlock Grid.Column="4" Text="像素V" Style="{StaticResource StatusLabelText}" />
                                <TextBlock Grid.Column="5" Text="残差(mm)" Style="{StaticResource StatusLabelText}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CalibrationPoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{StaticResource StatusValueText}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PlatformX, StringFormat={}{0:F2}}" Style="{StaticResource StatusValueText}" />
                                                <TextBlock Grid.Column="2" Text="{Binding PlatformY, StringFormat={}{0:F2}}" Style="{StaticResource StatusValueText}" />
                                                <TextBlock Grid.Column="3" Text="{Binding PixelU, StringFormat={}{0:F1}}" Style="{StaticResource StatusValueText}" />
                                                <TextBlock Grid.Column="4" Text="{Binding PixelV, StringFormat={}{0:F1}}" Style="{StaticResource StatusValueText}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Residual, StringFormat={}{0:F4}}" Style="{StaticResource StatusValueText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 结果 + 保存 -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding CalibrationResultText}"
                                   Style="{StaticResource StatusValueText}"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Grid.Column="1" Content="保存标定" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCalibrationCommand}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

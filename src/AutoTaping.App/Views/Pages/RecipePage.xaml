<!--
    职责：参数配方页——配方选择/加载/另存为/导入导出、参数分组编辑、范围校验、变更记录与保存审计
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、RecipeViewModel（颜色/字号/尺寸全部引用资源字典）
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.RecipePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgMain}">

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 配方选择条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="配方"
                           Style="{StaticResource StatusLabelText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Recipes}"
                          SelectedItem="{Binding SelectedRecipe}"
                          DisplayMemberPath="Name"
                          MinWidth="260"
                          Margin="0,0,16,0" />

                <Button Grid.Column="2" Content="加 载" Style="{StaticResource SmallButton}"
                        Command="{Binding LoadCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="另存为" Style="{StaticResource SmallButton}"
                        Command="{Binding SaveAsCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="导 入" Style="{StaticResource SmallButton}"
                        Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="5" Content="导 出" Style="{StaticResource SmallButton}"
                        Command="{Binding ExportCommand}" Margin="0,0,8,0" />

                <TextBlock Grid.Column="6"
                           Text="「加载」= 把当前配方设为生产配方，下一个节拍生效"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ==================== 分组树 + 参数编辑区 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 参数分组（左侧） -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0">
                <ListBox ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Height" Value="56" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource StatusInfo}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 参数编辑区（右侧） -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标量参数（工艺 / 位置 / 视觉 / 报警阈值） -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="12"
                        Visibility="{Binding IsTapePathGroup, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="404"
                                            Background="{StaticResource BgCard}"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            Padding="12,8"
                                            Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding DisplayName}"
                                                       FontSize="{StaticResource FontSizeHint}"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBox Width="130"
                                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ParameterInputBox}"
                                                         IsReadOnly="{Binding IsReadOnly}"
                                                         HorizontalContentAlignment="Right" />
                                                <TextBlock Text="{Binding Unit}"
                                                           Style="{StaticResource UnitText}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0" />
                                                <TextBlock Text="{Binding HintText}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="210">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource HintText}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource StatusAlarm}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 贴附路径（模式 + 路径点 + 圆弧参数） -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorder}"
                        Visibility="{Binding IsTapePathGroup, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="路径模式" Style="{StaticResource StatusLabelText}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding TapePathModes}"
                                      SelectedItem="{Binding TapePathMode}"
                                      IsEnabled="{Binding CanEdit}"
                                      Width="160"
                                      Margin="8,0,16,0" />
                            <Button Content="添加路径点" Style="{StaticResource SmallButton}"
                                    Command="{Binding AddPointCommand}" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="{StaticResource BgCard}"
                                CornerRadius="{StaticResource ControlCornerRadius}" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TapePathPoints}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Index}"
                                                           Style="{StaticResource NumericText}"
                                                           FontSize="{StaticResource FontSizeHint}"
                                                           Width="32"
                                                           VerticalAlignment="Center" />
                                                <TextBox Width="110" Text="{Binding Xt, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ParameterInputBox}"
                                                         IsReadOnly="{Binding IsReadOnly}" Margin="0,0,8,0" />
                                                <TextBox Width="110" Text="{Binding Yt, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ParameterInputBox}"
                                                         IsReadOnly="{Binding IsReadOnly}" Margin="0,0,8,0" />
                                                <TextBox Width="90" Text="{Binding Zt, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ParameterInputBox}"
                                                         IsReadOnly="{Binding IsReadOnly}" Margin="0,0,8,0" />
                                                <TextBlock Text="X / Y / Z（mm）"
                                                           Style="{StaticResource HintText}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,16,0" />
                                                <Button Content="删 除" Style="{StaticResource SmallButton}"
                                                        Command="{Binding DataContext.RemovePointCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="圆心 X" Style="{StaticResource StatusLabelText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Width="100" Text="{Binding ArcCenterXText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInputBox}" IsEnabled="{Binding IsArcMode}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="圆心 Y" Style="{StaticResource StatusLabelText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="3" Width="100" Text="{Binding ArcCenterYText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInputBox}" IsEnabled="{Binding IsArcMode}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Margin="0,0,16,0" />
                            <TextBlock Grid.Column="4" Text="半径" Style="{StaticResource StatusLabelText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="5" Width="100" Text="{Binding ArcRadiusText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInputBox}" IsEnabled="{Binding IsArcMode}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Margin="0,0,16,0" />
                            <TextBlock Grid.Column="6" Text="起止角" Style="{StaticResource StatusLabelText}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Column="7" Width="90" Text="{Binding ArcStartText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInputBox}" IsEnabled="{Binding IsArcMode}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Margin="0,0,8,0" />
                            <TextBox Grid.Column="8" Width="90" Text="{Binding ArcEndText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericInputBox}" IsEnabled="{Binding IsArcMode}"
                                     IsReadOnly="{Binding IsReadOnly}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- 参数变更记录 -->
                <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="参数变更记录" Style="{StaticResource GroupTitleText}" FontSize="{StaticResource FontSizeBody}" />
                        <ItemsControl ItemsSource="{Binding ChangeLogs}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=MM-dd HH:mm:ss}"
                                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding UserName}"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Target}"
                                                   FontSize="{StaticResource FontSizeHint}"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding OldValue}" FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text=" → " FontSize="{StaticResource FontSizeHint}"
                                                   Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock Text="{Binding NewValue}" FontSize="{StaticResource FontSizeHint}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== 底部操作 ==================== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="保 存" Style="{StaticResource PrimaryButton}"
                    Height="{StaticResource ButtonPrimaryMinHeight}"
                    Command="{Binding SaveCommand}" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="恢复默认" Style="{StaticResource NormalButton}"
                    Height="{StaticResource ButtonPrimaryMinHeight}"
                    Command="{Binding RestoreDefaultCommand}" Margin="0,0,16,0" />

            <TextBlock Grid.Column="2" Text="{Binding UnsavedHintText}" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValueText}">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource StatusWarn}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                       Style="{StaticResource HintText}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>

<!--
    职责：产量统计页——查询条、四个统计卡片、小时柱状图（矩形绘制，不引第三方图表库）、停机分析、明细表
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、OutputViewModel
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.OutputPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgMain}">

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 查询条 ==================== -->
        <Border Grid.Row="0" Style="{StaticResource PanelBorder}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="日期" Style="{StaticResource StatusLabelText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" Width="140" Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource NumericInputBox}" Margin="0,0,16,0" />

                <TextBlock Grid.Column="2" Text="班次" Style="{StaticResource StatusLabelText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="3" Width="150" ItemsSource="{Binding ShiftOptions}"
                          SelectedItem="{Binding SelectedShiftText}" Margin="0,0,16,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="查 询" Style="{StaticResource SmallButton}"
                            Command="{Binding QueryCommand}" Margin="0,0,8,0" />
                    <Button Content="导出CSV" Style="{StaticResource SmallButton}"
                            Command="{Binding ExportCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="5"
                           Text="卡片、柱状图与停机分析为整日数据；班次筛选作用于明细表"
                           Style="{StaticResource HintText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ==================== 统计卡片 ==================== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="总产量" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource CardValueText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="良率" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="{Binding YieldText}" Style="{StaticResource CardValueText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="平均节拍" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="{Binding CycleText}" Style="{StaticResource CardValueText}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="运行时长" Style="{StaticResource CardTitleText}" />
                    <TextBlock Text="{Binding RunTimeText}" Style="{StaticResource CardValueText}" />
                    <TextBlock Text="{Binding ShiftText}" Style="{StaticResource HintText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 小时柱状图 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="按小时产量" Style="{StaticResource GroupTitleText}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding HourlyBars}" Height="{StaticResource HourlyBarAreaHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding CountText}"
                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                           FontSize="{StaticResource FontSizeHint}"
                                           HorizontalAlignment="Center" />
                                <Border Width="{StaticResource HourlyBarWidth}"
                                        Height="{Binding BarHeight}"
                                        HorizontalAlignment="Center"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource StatusIdle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasData}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource StatusRun}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding HourText}"
                                           FontFamily="{StaticResource FontFamilyNumeric}"
                                           FontSize="{StaticResource FontSizeHint}"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ==================== 停机分析 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="停机分析" Style="{StaticResource GroupTitleText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding DownTimeText}" Style="{StaticResource HintText}"
                           VerticalAlignment="Center" Margin="0,0,24,0" />
                <ItemsControl ItemsSource="{Binding Downtimes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Count}" Style="{StaticResource NumericText}"
                                           FontSize="{StaticResource FontSizeUnit}" VerticalAlignment="Center" />
                                <TextBlock Text="次" Style="{StaticResource UnitText}"
                                           VerticalAlignment="Center" Margin="4,0,8,0" />
                                <TextBlock Text="{Binding TotalText}" Style="{StaticResource NumericText}"
                                           FontSize="{StaticResource FontSizeUnit}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ==================== 明细（最近 100 条） ==================== -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="明细（最近 100 条）"
                           Style="{StaticResource GroupTitleText}" Margin="0,0,0,8" />

                <DataGrid Grid.Row="1"
                          Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Records}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Width="90" Binding="{Binding SequenceNo}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="时间" Width="190"
                                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="配方" Width="*" Binding="{Binding RecipeName}" />
                        <DataGridTextColumn Header="结果" Width="80" Binding="{Binding Result}" />
                        <DataGridTextColumn Header="节拍(ms)" Width="110" Binding="{Binding CycleTimeMs}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="ΔX(mm)" Width="100" Binding="{Binding DeltaX, StringFormat=F2}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="ΔY(mm)" Width="100" Binding="{Binding DeltaY, StringFormat=F2}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="NG原因" Width="160" Binding="{Binding NgReason}" />
                        <DataGridTextColumn Header="班次" Width="90" Binding="{Binding Shift}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ==================== 状态提示 ==================== -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusText}"
                   Style="{StaticResource HintText}"
                   Margin="0,8,0,0" />
    </Grid>
</UserControl>

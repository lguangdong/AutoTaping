<!--
    职责：自动运行页（主画面）——工位状态与流转箭头 + 2.5D 侧视示意图 + 实时曲线 + 数值/统计/通讯
          （08-页面清单 页面 1，只读页面，无任何修改操作）
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、Converters（颜色/字号/尺寸全部引用资源字典）
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.AutoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoTaping.App.Converters"
             Background="{StaticResource BgMain}">

    <UserControl.Resources>
        <converters:DeviceStateToBrushConverter x:Key="DeviceStateToBrush" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶部横幅（未回零 / 未选择配方） ==================== -->
        <StackPanel Grid.Row="0">
            <Border Background="{StaticResource StatusWait}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="{StaticResource SpacingMedium}"
                    Margin="0,0,0,8"
                    Visibility="{Binding NotHomed, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="设备未回零，请先执行回零（复位按钮触发回零）"
                           Foreground="{StaticResource BgMain}"
                           FontWeight="Bold" />
            </Border>
            <Border Background="{StaticResource StatusWait}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Padding="{StaticResource SpacingMedium}"
                    Margin="0,0,0,8"
                    Visibility="{Binding NoRecipe, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="未选择配方，请先到参数页选择"
                           Foreground="{StaticResource BgMain}"
                           FontWeight="Bold" />
            </Border>
        </StackPanel>

        <!-- ==================== 工艺流程图（4 工位状态点 + 流转箭头，点击查看详情） ==================== -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBorder}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Ellipse Width="{StaticResource StatusLampSize}"
                             Height="{StaticResource StatusLampSize}"
                             Fill="{Binding State, Converter={StaticResource DeviceStateToBrush}}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateText}"
                               FontSize="{StaticResource FontSizeGroupTitle}"
                               FontWeight="Bold"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StepText}"
                               Style="{StaticResource StatusValueText}"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 上料位 -->
                    <Border Grid.Column="0" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ShowStationDetailCommand}"
                                          CommandParameter="load" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadHasMaterial}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BgCard}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LoadActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusRun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="{StaticResource StationDotSize}" Height="{StaticResource StationDotSize}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoadHasMaterial}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="上料位" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding LoadStateText}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 上料 → 拍照 -->
                    <TextBlock Grid.Column="1" Text="▶" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Arrow1Active}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource StatusRun}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 拍照位 -->
                    <Border Grid.Column="2" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ShowStationDetailCommand}"
                                          CommandParameter="photo" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CameraOk}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BgCard}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PhotoActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusRun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="{StaticResource StationDotSize}" Height="{StaticResource StationDotSize}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CameraOk}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="拍照位" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding PhotoStateText}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 拍照 → 贴附 -->
                    <TextBlock Grid.Column="3" Text="▶" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Arrow2Active}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource StatusRun}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 贴附位 -->
                    <Border Grid.Column="4" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ShowStationDetailCommand}"
                                          CommandParameter="tape" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TapeHasMaterial}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BgCard}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TapeActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusRun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="{StaticResource StationDotSize}" Height="{StaticResource StationDotSize}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VacuumOn}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="贴附位" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding TapeStateText}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 贴附 → 下料 -->
                    <TextBlock Grid.Column="5" Text="▶" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Arrow3Active}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource StatusRun}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 下料位 -->
                    <Border Grid.Column="6" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding ShowStationDetailCommand}"
                                          CommandParameter="unload" />
                        </Border.InputBindings>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource PanelBorder}">
                                <Setter Property="Padding" Value="8" />
                                <Setter Property="Background" Value="{StaticResource BgPanel}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UnloadHasMaterial}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BgCard}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UnloadActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource StatusRun}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="{StaticResource StationDotSize}" Height="{StaticResource StationDotSize}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding UnloadHasMaterial}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="下料位" FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Text="{Binding UnloadStateText}"
                                       Style="{StaticResource HintText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding OutputText}"
                                       FontFamily="{StaticResource FontFamilyNumeric}"
                                       FontSize="{StaticResource FontSizeHint}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 2.5D 侧视示意图（贴胶头按 X/Z 实时位置映射） ==================== -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备侧视示意" Style="{StaticResource GroupTitleText}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding HeadPositionText}"
                               FontFamily="{StaticResource FontFamilyNumeric}"
                               FontSize="{StaticResource FontSizeHint}"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 画布固定 800×200 设计尺寸，由 Viewbox 等比缩放填满面板 -->
                <Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Canvas Width="800" Height="200" ClipToBounds="True">

                        <!-- 台面 -->
                        <Rectangle Canvas.Left="0" Canvas.Top="156" Width="800" Height="12"
                                   Fill="{StaticResource BgCard}"
                                   Stroke="{StaticResource BorderNormal}" StrokeThickness="1" />
                        <TextBlock Canvas.Left="768" Canvas.Top="170" Text="台面"
                                   FontSize="12" Foreground="{StaticResource TextDisabled}" />

                        <!-- X 导轨（横梁） -->
                        <Rectangle Canvas.Left="0" Canvas.Top="18" Width="800" Height="8"
                                   Fill="{StaticResource BorderNormal}" />
                        <TextBlock Canvas.Left="8" Canvas.Top="2" Text="X 导轨"
                                   FontSize="12" Foreground="{StaticResource TextDisabled}" />

                        <!-- 四个工位标记（台面上的料位） -->
                        <Rectangle Canvas.Left="20" Canvas.Top="146" Width="150" Height="10" RadiusX="2" RadiusY="2">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource BorderNormal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoadActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Canvas.Left="20" Canvas.Top="170" Width="150" Text="上料位"
                                   FontSize="14" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                        <Rectangle Canvas.Left="215" Canvas.Top="146" Width="150" Height="10" RadiusX="2" RadiusY="2">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource BorderNormal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhotoActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Canvas.Left="215" Canvas.Top="170" Width="150" Text="拍照位"
                                   FontSize="14" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                        <Rectangle Canvas.Left="410" Canvas.Top="146" Width="150" Height="10" RadiusX="2" RadiusY="2">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource BorderNormal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TapeActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Canvas.Left="410" Canvas.Top="170" Width="150" Text="贴附位"
                                   FontSize="14" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                        <Rectangle Canvas.Left="605" Canvas.Top="146" Width="150" Height="10" RadiusX="2" RadiusY="2">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Fill" Value="{StaticResource BorderNormal}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnloadActive}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Canvas.Left="605" Canvas.Top="170" Width="150" Text="下料位"
                                   FontSize="14" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" />

                        <!-- 贴胶头：Left 由 X 轴位置映射，Top 由 Z 轴位置映射（Z 越大越靠上） -->
                        <Canvas Width="48" Height="60"
                                Canvas.Left="{Binding HeadCanvasLeft}"
                                Canvas.Top="{Binding HeadCanvasTop}">
                            <Rectangle Width="48" Height="34"
                                       Fill="{StaticResource BgCard}"
                                       Stroke="{StaticResource StatusInfo}" StrokeThickness="2" />
                            <TextBlock Canvas.Left="14" Canvas.Top="6" Text="Z" FontSize="14" FontWeight="Bold" />
                            <!-- 吸嘴：真空吸住时变绿 -->
                            <Rectangle Canvas.Left="18" Canvas.Top="34" Width="12" Height="16">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="Fill" Value="{StaticResource BorderNormal}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VacuumOn}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>

        <!-- ==================== 实时曲线 + 状态数据 / 通讯状态 ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 实时曲线（08-页面清单 页面 1：Polyline ×2，最近 300 点） -->
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="X 轴位置（最近 300 点）" Style="{StaticResource StatusLabelText}" />
                        <TextBlock Text="{Binding XCurveValueText}"
                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                   Style="{StaticResource StatusValueText}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource BgMain}" Margin="0,0,0,12">
                        <Viewbox Stretch="Fill" StretchDirection="Both">
                            <Canvas Width="300" Height="100" ClipToBounds="True">
                                <Polyline Points="{Binding XCurvePoints}"
                                          Stroke="{StaticResource StatusInfo}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,0,0,4">
                        <TextBlock Text="Z 轴位置（最近 300 点）" Style="{StaticResource StatusLabelText}" />
                        <TextBlock Text="{Binding ZCurveValueText}"
                                   FontFamily="{StaticResource FontFamilyNumeric}"
                                   Style="{StaticResource StatusValueText}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Border Grid.Row="3" Background="{StaticResource BgMain}">
                        <Viewbox Stretch="Fill" StretchDirection="Both">
                            <Canvas Width="300" Height="100" ClipToBounds="True">
                                <Polyline Points="{Binding ZCurvePoints}"
                                          Stroke="{StaticResource StatusRun}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>

            <!-- 当班统计 + 贴胶头数值 + 通讯状态 -->
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左列：当班统计 -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="当班统计" Style="{StaticResource GroupTitleText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="节拍" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CycleTimeText}" Style="{StaticResource NumericText}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="产量" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutputText}" Style="{StaticResource NumericText}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="良率" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding YieldText}" Style="{StaticResource NumericText}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="连续运行" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RunTimeText}" FontFamily="{StaticResource FontFamilyNumeric}" Style="{StaticResource StatusValueText}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="最后拍照" Style="{StaticResource StatusLabelText}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastCaptureText}" FontFamily="{StaticResource FontFamilyNumeric}" Style="{StaticResource StatusValueText}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- 右列：贴胶头数值 + 通讯状态 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="贴胶头" Style="{StaticResource GroupTitleText}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Z 轴" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ZText}" Style="{StaticResource StatusValueText}" FontFamily="{StaticResource FontFamilyNumeric}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="R 轴" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RText}" Style="{StaticResource StatusValueText}" FontFamily="{StaticResource FontFamilyNumeric}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="真空" Style="{StaticResource StatusLabelText}" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VacuumText}" Style="{StaticResource StatusValueText}" HorizontalAlignment="Right" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="气压" Style="{StaticResource StatusLabelText}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PressureText}" Style="{StaticResource StatusValueText}" HorizontalAlignment="Right" />
                        </Grid>

                        <TextBlock Text="通讯状态" Style="{StaticResource GroupTitleText}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="{StaticResource StatusLampSize}"
                                     Height="{StaticResource StatusLampSize}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="相机" Style="{StaticResource StatusValueText}" Margin="0,0,16,0" />

                            <Ellipse Width="{StaticResource StatusLampSize}"
                                     Height="{StaticResource StatusLampSize}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource StatusIdle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MotionOk}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource StatusRun}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="运控卡" Style="{StaticResource StatusValueText}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

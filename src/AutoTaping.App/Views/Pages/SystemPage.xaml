<!--
    职责：系统设置页——版本信息、用户管理、数据维护（备份 / 清理 / 自检 / 退出）、最近操作日志（08-页面清单 页面 8）
    层：App/Views/Pages
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、Converters、SystemViewModel
-->
<UserControl x:Class="AutoTaping.App.Views.Pages.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoTaping.App.Converters"
             Background="{StaticResource BgMain}">

    <UserControl.Resources>
        <converters:UserRoleToTextConverter x:Key="UserRoleToText" />
        <converters:UserEnabledToTextConverter x:Key="UserEnabledToText" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="300" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource PageTitleText}" />

        <!-- ==================== 版本信息 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
            <UniformGrid Columns="3" Rows="2">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="软件版本" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding SoftwareVersion}" Style="{StaticResource StatusValueText}"
                               FontFamily="{StaticResource FontFamilyNumeric}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="硬件模式" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding HardwareModeText}" Style="{StaticResource StatusValueText}" />
                </StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="运行时长" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding UptimeText}" Style="{StaticResource StatusValueText}"
                               FontFamily="{StaticResource FontFamilyNumeric}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="数据库" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource StatusValueText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="最后标定" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding LastCalibrationText}" Style="{StaticResource StatusValueText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="最近备份位置" Style="{StaticResource StatusLabelText}" />
                    <TextBlock Text="{Binding BackupDirectoryText}" Style="{StaticResource StatusValueText}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ==================== 用户管理 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="用户管理" Style="{StaticResource GroupTitleText}"
                               VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Grid.Column="1" Content="新增用户" Style="{StaticResource SmallButton}"
                            Command="{Binding CreateUserCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="修改角色" Style="{StaticResource SmallButton}"
                            Command="{Binding ChangeRoleCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Content="改 密" Style="{StaticResource SmallButton}"
                            Command="{Binding ResetPasswordCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Content="{Binding ToggleEnabledText}" Style="{StaticResource SmallButton}"
                            Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="5" Content="删 除" Style="{StaticResource SmallButton}"
                            Command="{Binding DeleteUserCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="6" Content="刷 新" Style="{StaticResource SmallButton}"
                            Command="{Binding RefreshCommand}" />
                    <TextBlock Grid.Column="7" Text="先在下方选中一个账户，再执行修改角色 / 改密 / 禁用 / 删除"
                               Style="{StaticResource HintText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                </Grid>

                <DataGrid Grid.Row="1"
                          Style="{StaticResource DataGridStyle}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="用户名" Width="180" Binding="{Binding UserName}" />
                        <DataGridTextColumn Header="角色" Width="140"
                                            Binding="{Binding Role, Converter={StaticResource UserRoleToText}}" />
                        <DataGridTextColumn Header="状态" Width="120"
                                            Binding="{Binding IsEnabled, Converter={StaticResource UserEnabledToText}}" />
                        <DataGridTextColumn Header="创建时间" Width="200"
                                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                        <DataGridTextColumn Header="最后登录" Width="*"
                                            Binding="{Binding LastLoginAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            FontFamily="{StaticResource FontFamilyNumeric}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ==================== 数据维护 + 最近操作日志 ==================== -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="5*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="数据维护" Style="{StaticResource GroupTitleText}"
                               Margin="0,0,0,8" />

                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Content="一键备份" Style="{StaticResource SmallButton}"
                                Command="{Binding BackupCommand}" Margin="0,0,8,8" />
                        <Button Content="清理旧数据" Style="{StaticResource SmallButton}"
                                Command="{Binding CleanupCommand}" Margin="0,0,8,8" />
                        <Button Content="立即自检" Style="{StaticResource SmallButton}"
                                Command="{Binding SelfCheckCommand}" Margin="0,0,8,8" />
                        <Button Content="退出程序" Style="{StaticResource DangerButton}"
                                Command="{Binding ExitApplicationCommand}"
                                MinWidth="{StaticResource ButtonSmallMinWidth}"
                                MinHeight="{StaticResource ButtonSmallMinHeight}"
                                FontSize="{StaticResource FontSizeBody}"
                                Margin="0,0,0,8" />
                    </WrapPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding SelfCheckText}"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BackupDirectoryText}"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource HintText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="最近操作日志" Style="{StaticResource GroupTitleText}"
                               Margin="0,0,0,8" />

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource DataGridStyle}"
                              ItemsSource="{Binding RecentLogs}"
                              RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Width="150"
                                                Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm:ss}"
                                                FontFamily="{StaticResource FontFamilyNumeric}" />
                            <DataGridTextColumn Header="用户" Width="100" Binding="{Binding UserName}" />
                            <DataGridTextColumn Header="动作" Width="120" Binding="{Binding Action}" />
                            <DataGridTextColumn Header="对象" Width="*" Binding="{Binding Target}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

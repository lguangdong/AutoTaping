<!--
    职责：登录框——用户名 / 口令输入与失败原因提示（07-UI设计规范 第 8 节、08 全局交互约定）
    层：App/Views/Dialogs
    依赖：Resources/Colors.xaml、Resources/Styles.xaml、LoginViewModel
-->
<Window x:Class="AutoTaping.App.Views.Dialogs.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 自动贴胶机上位机"
        Width="{StaticResource LoginDialogWidth}"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgMain}"
        Foreground="{StaticResource TextPrimary}"
        FocusManager.FocusedElement="{Binding ElementName=UserNameInput}">

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="自动贴胶机上位机" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="请输入用户名与口令后登录"
                       Style="{StaticResource HintText}"
                       Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="用户名" Style="{StaticResource StatusLabelText}" />
            <TextBox x:Name="UserNameInput"
                     Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="口令" Style="{StaticResource StatusLabelText}" />
            <!-- PasswordBox.Password 不是依赖属性，无法绑定；由 code-behind 同步到 ViewModel -->
            <PasswordBox x:Name="PasswordInput"
                         PasswordChanged="OnPasswordChanged"
                         Margin="0,8,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource StatusAlarm}"
                   MinHeight="28"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取 消"
                    Style="{StaticResource NormalButton}"
                    IsCancel="True"
                    Margin="0,0,16,0" />
            <Button Content="登 录"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Command="{Binding LoginCommand}" />
        </StackPanel>
    </Grid>
</Window>

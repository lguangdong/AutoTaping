<!--
    职责：单行文本输入对话框（配方「另存为」的名称输入等），仅负责收集文本，不做业务校验
    层：App/Views/Dialogs
    依赖：Resources/Colors.xaml、Resources/Styles.xaml
-->
<Window x:Class="AutoTaping.App.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="{StaticResource LoginDialogWidth}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgMain}"
        Foreground="{StaticResource TextPrimary}"
        FocusManager.FocusedElement="{Binding ElementName=TextInputBox}">

    <Grid Margin="{StaticResource SpacingLarge}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="LabelText" Grid.Row="0" Style="{StaticResource StatusLabelText}" />

        <TextBox x:Name="TextInputBox"
                 Grid.Row="1"
                 Margin="0,8,0,0"
                 AutomationProperties.AutomationId="TextInputBox" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="取 消" Style="{StaticResource NormalButton}" IsCancel="True" Margin="0,0,16,0" />
            <Button Content="确 定"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>

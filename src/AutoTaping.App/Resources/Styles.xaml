<!--
    职责：全局字体/字号/间距常量与按钮、输入框样式（View 中禁止写死颜色、字号、尺寸）
    层：App/Resources
    依赖：Colors.xaml（必须先合并 Colors.xaml，再合并本文件）
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:AutoTaping.App.Converters"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  转换器定义在本字典内：IO 点位模板就在本文件，避免跨字典 StaticResource 解析顺序问题  -->
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!--  ===================== 字体与字号（07-UI设计规范 第 3 节） =====================  -->
    <FontFamily x:Key="FontFamilyBase">Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontFamilyNumeric">Consolas</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeGroupTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeBody">20</sys:Double>
    <sys:Double x:Key="FontSizeNumeric">28</sys:Double>
    <sys:Double x:Key="FontSizeUnit">18</sys:Double>
    <sys:Double x:Key="FontSizeHint">16</sys:Double>
    <sys:Double x:Key="FontSizeButtonPrimary">24</sys:Double>

    <!--  ===================== 尺寸与间距（07-UI设计规范 第 4 节：间距只用 8 / 16 / 24） =====================  -->
    <sys:Double x:Key="ButtonPrimaryMinWidth">160</sys:Double>
    <sys:Double x:Key="ButtonPrimaryMinHeight">72</sys:Double>
    <sys:Double x:Key="ButtonMinWidth">120</sys:Double>
    <sys:Double x:Key="ButtonMinHeight">56</sys:Double>
    <sys:Double x:Key="InputMinHeight">48</sys:Double>

    <!--  主窗口尺寸：设计基准 1280×1024（07-UI设计规范 开头）  -->
    <sys:Double x:Key="MainWindowWidth">1280</sys:Double>
    <sys:Double x:Key="MainWindowHeight">1024</sys:Double>
    <sys:Double x:Key="MainWindowMinWidth">1024</sys:Double>
    <sys:Double x:Key="MainWindowMinHeight">768</sys:Double>

    <!--  主窗口壳各区域尺寸（07-UI设计规范 第 5.1 节）  -->
    <!--  行高/列宽必须用 GridLength：Grid 的 Height/Width 不接受 Double，直接用 Double 会在加载 XAML 时抛异常  -->
    <GridLength x:Key="StatusBarRowHeight">64</GridLength>
    <GridLength x:Key="OperationBarRowHeight">96</GridLength>
    <GridLength x:Key="NavColumnWidth">120</GridLength>
    <sys:Double x:Key="NavButtonWidth">120</sys:Double>
    <sys:Double x:Key="NavButtonHeight">72</sys:Double>
    <sys:Double x:Key="StatusLampSize">20</sys:Double>
    <sys:Double x:Key="StationDotSize">12</sys:Double>
    <sys:Double x:Key="FontSizeNavIcon">22</sys:Double>
    <sys:Double x:Key="FontSizeNavLabel">18</sys:Double>
    <sys:Double x:Key="AlarmBadgeHeight">48</sys:Double>
    <sys:Double x:Key="LoginDialogWidth">520</sys:Double>

    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">16</Thickness>
    <Thickness x:Key="SpacingLarge">24</Thickness>

    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>

    <!--  ===================== 文本（默认样式，页面里不要重复设置字号） =====================  -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style
        x:Key="PageTitleText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="GroupTitleText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeGroupTitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  关键数值：等宽字体，实时刷新时数字不跳动（07-UI设计规范 第 3 节）  -->
    <Style
        x:Key="NumericText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeNumeric}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style
        x:Key="UnitText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style
        x:Key="HintText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHint}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!--  ===================== 输入框（高度 48，深色主题） =====================  -->
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource InputMinHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource SpacingSmall}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  ===================== 按钮：普通（默认） =====================  -->
    <!--
        说明：07 文档色板只定义了 BtnPrimaryHover，未定义普通/危险按钮的悬停色，
        为避免自行发明颜色（禁止装饰性用色），这两个按钮不做悬停变色，只做禁用态区分。
    -->
    <Style x:Key="NormalButton" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonMinHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BtnNormal}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter
                            Margin="{StaticResource SpacingSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BtnDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BtnDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  未指定样式时使用普通按钮外观  -->
    <Style BasedOn="{StaticResource NormalButton}" TargetType="Button" />

    <!--  ===================== 按钮：主操作（启动等） =====================  -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonPrimaryMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonPrimaryMinHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeButtonPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BtnPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BtnPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter
                            Margin="{StaticResource SpacingSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BtnPrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource BtnPrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BtnDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 按钮：危险操作（停止 / 复位） =====================  -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonMinHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BtnDanger}" />
        <Setter Property="BorderBrush" Value="{StaticResource BtnDanger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter
                            Margin="{StaticResource SpacingSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource BtnDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 口令输入框（登录框用，高度 48，外观与 TextBox 一致） =====================  -->
    <Style TargetType="PasswordBox">
        <Setter Property="MinHeight" Value="{StaticResource InputMinHeight}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource SpacingSmall}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  ===================== 小按钮（88×48，面板内操作，07-UI设计规范 第 4 节） =====================  -->
    <sys:Double x:Key="ButtonSmallMinWidth">88</sys:Double>
    <sys:Double x:Key="ButtonSmallMinHeight">48</sys:Double>
    <sys:Double x:Key="IoPointTileMinHeight">80</sys:Double>

    <Style
        x:Key="SmallButton"
        BasedOn="{StaticResource NormalButton}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonSmallMinWidth}" />
        <Setter Property="MinHeight" Value="{StaticResource ButtonSmallMinHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!--  ===================== 选项卡（深色；选中项用卡片底 + 信息色下划线） =====================  -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="TabBorder"
                        Margin="0,0,4,0"
                        Padding="16,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgCard}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource StatusInfo}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 页面内分组面板（统一外观，View 里不再重复写背景/边框） =====================  -->
    <Style x:Key="PanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SpacingMedium}" />
    </Style>

    <!--  ===================== 数值输入框（等宽字体，右对齐） =====================  -->
    <Style
        x:Key="NumericInputBox"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!--  目标位置输入框：超软限位时红框（08-页面清单 页面 2 交互规则）  -->
    <Style
        x:Key="TargetInputBox"
        BasedOn="{StaticResource NumericInputBox}"
        TargetType="TextBox">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasTargetError}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource StatusAlarm}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ===================== IO 点位方块（绿 = ON，深灰 = OFF，强制 = 黄边框） =====================  -->
    <Style x:Key="IoPointTile" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="MinHeight" Value="{StaticResource IoPointTileMinHeight}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter Property="Background" Value="{StaticResource StatusRun}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsForced}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource StatusWait}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="IoPointTileTemplate">
        <Border Style="{StaticResource IoPointTile}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        FontFamily="{StaticResource FontFamilyNumeric}"
                        FontSize="{StaticResource FontSizeBody}"
                        FontWeight="Bold"
                        Text="{Binding Point}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource FontFamilyNumeric}"
                        FontSize="{StaticResource FontSizeHint}"
                        FontWeight="Bold"
                        Text="{Binding StateText}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="{StaticResource FontSizeHint}"
                    Text="{Binding DisplayName}"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="{StaticResource FontSizeHint}"
                    Foreground="{StaticResource StatusWait}"
                    Text="强制"
                    Visibility="{Binding IsForced, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--
        下拉框（高度 48，深色主题）。
        必须自定义模板：系统模板的弹出层底色取自 SystemColors.WindowBrush（浅色），而全局 TextBlock 样式
        把文字固定为白色，ItemTemplate 里的 TextBlock 又不吃 ComboBoxItem.Foreground，于是必然「白底白字」。
        这里把弹出层改成 BgPanel 深色，主框与项统一深色底 + 白字，任何主题下都清晰。
    -->
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource InputMinHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidth}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgInput}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="Padding" Value="{StaticResource SpacingSmall}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--  主框：整块可点，点击切换展开  -->
                        <ToggleButton
                            x:Name="ToggleButton"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                Grid.Column="1"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 L 6 6 L 12 0"
                                                Stroke="{StaticResource TextSecondary}"
                                                StrokeThickness="2" />
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--  选中项显示（不参与命中测试，点击穿透到 ToggleButton）  -->
                        <ContentPresenter
                            x:Name="ContentSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False"
                            TextElement.Foreground="{StaticResource TextPrimary}" />

                        <!--  弹出层：深色底，与页面主题一致  -->
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource BorderNormal}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  下拉项：深色底 + 白字，悬停用主色、选中用卡片色，保持 48 触摸高度  -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Padding" Value="{StaticResource SpacingSmall}" />
        <Setter Property="MinHeight" Value="{StaticResource InputMinHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCard}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BtnPrimary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 行程条（四轴实时位置：0~100 百分比，细条不抢视线） =====================  -->
    <Style x:Key="AxisRangeBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource StatusInfo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!--  必须是 PART_Track：ProgressBar 用它取总长度，再按 Value/Maximum 设置 PART_Indicator 的宽度  -->
                    <Grid x:Name="PART_Track">
                        <Border
                            Background="{StaticResource BgMain}"
                            BorderBrush="{StaticResource BorderNormal}"
                            BorderThickness="1"
                            CornerRadius="4" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="4" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 状态栏文字（07-UI设计规范 第 5.1 节） =====================  -->
    <Style
        x:Key="StatusLabelText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style
        x:Key="StatusValueText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!--  ===================== 导航按钮（120×72，图标 + 文字，07-UI设计规范 第 5.2 节） =====================  -->
    <!--  权限不足时置灰但仍可点击：点击由 ShellViewModel 提示需要什么角色（08 全局交互约定）  -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource NavButtonWidth}" />
        <Setter Property="Height" Value="{StaticResource NavButtonHeight}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource BgPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeNavIcon}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Icon}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="{StaticResource FontSizeNavLabel}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Title}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgCard}" />
                        </Trigger>
                        <!--  选中态用 StatusInfo（信息色 = 选中，07-UI设计规范 2.3）  -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Background" Value="{StaticResource StatusInfo}" />
                        </DataTrigger>
                        <!--  权限不足：置灰（必须明显可见，07-UI设计规范 9.3）  -->
                        <DataTrigger Binding="{Binding IsAllowed}" Value="False">
                            <Setter Property="Background" Value="{StaticResource BtnDisabled}" />
                            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===================== 表格（报警页 / 产量页，深色主题；不引入任何第三方表格库） =====================  -->
    <sys:Double x:Key="DataGridRowHeight">44</sys:Double>
    <sys:Double x:Key="DataGridHeaderHeight">44</sys:Double>
    <sys:Double x:Key="CardValueFontSize">32</sys:Double>
    <sys:Double x:Key="HourlyBarAreaHeight">150</sys:Double>
    <sys:Double x:Key="HourlyBarWidth">32</sys:Double>

    <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgCard}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="{StaticResource DataGridHeaderHeight}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="GridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHint}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{StaticResource BorderNormal}"
                        BorderThickness="0,0,1,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource StatusInfo}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  行高由 DataGrid.RowHeight 控制：RowStyle 里设 Height 会覆盖单个表格的 RowHeight 覆盖值  -->
    <Style x:Key="GridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{StaticResource BgPanel}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource BgPanel}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="{StaticResource BgPanel}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BgMain}" />
        <Setter Property="RowHeight" Value="{StaticResource DataGridRowHeight}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderNormal}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource GridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource GridRowStyle}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyBase}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHint}" />
    </Style>

    <!--  ===================== 参数页输入框（超范围红框，08-页面清单 页面 3） =====================  -->
    <Style
        x:Key="ParameterInputBox"
        BasedOn="{StaticResource NumericInputBox}"
        TargetType="TextBox">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource StatusAlarm}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  ===================== 统计卡片（产量页四个数字卡片） =====================  -->
    <Style
        x:Key="CardTitleText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style
        x:Key="CardValueText"
        BasedOn="{StaticResource {x:Type TextBlock}}"
        TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyNumeric}" />
        <Setter Property="FontSize" Value="{StaticResource CardValueFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!--  ===================== 报警徽标（状态栏未确认报警数，红底白字，07-UI设计规范 第 5.1 节） =====================  -->
    <Style x:Key="AlarmBadgeButton" TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Height" Value="{StaticResource AlarmBadgeHeight}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeUnit}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="Background" Value="{StaticResource StatusAlarm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ControlCornerRadius}">
                        <ContentPresenter
                            Margin="{StaticResource SpacingSmall}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding UnackedAlarmCount}" Value="0">
                            <Setter Property="Background" Value="{StaticResource StatusIdle}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

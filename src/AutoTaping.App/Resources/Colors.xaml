<!--
    职责：全局色板（唯一颜色来源，View 中禁止出现 #FF 字面色值）
    层：App/Resources
    依赖：无（来源：07-UI设计规范 第 2 节）
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ===== 2.1 背景与面板 =====  -->
    <SolidColorBrush x:Key="BgMain" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BgPanel" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="BgCard" Color="#FF3A3A3D" />
    <SolidColorBrush x:Key="BgInput" Color="#FF252526" />
    <SolidColorBrush x:Key="BorderNormal" Color="#FF4A4A4D" />

    <!--  ===== 2.2 文字 =====  -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FF6B6B6B" />
    <SolidColorBrush x:Key="TextLink" Color="#FF4FC3F7" />

    <!--  ===== 2.3 状态色（语义固定，不得用作装饰） =====  -->
    <SolidColorBrush x:Key="StatusRun" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="StatusIdle" Color="#FF9E9E9E" />
    <SolidColorBrush x:Key="StatusWait" Color="#FFFFC107" />
    <SolidColorBrush x:Key="StatusWarn" Color="#FFFF9800" />
    <SolidColorBrush x:Key="StatusAlarm" Color="#FFF44336" />
    <SolidColorBrush x:Key="StatusInfo" Color="#FF2196F3" />

    <!--  ===== 2.4 按钮 =====  -->
    <SolidColorBrush x:Key="BtnPrimary" Color="#FF1976D2" />
    <SolidColorBrush x:Key="BtnPrimaryHover" Color="#FF2196F3" />
    <SolidColorBrush x:Key="BtnDanger" Color="#FFC62828" />
    <SolidColorBrush x:Key="BtnNormal" Color="#FF424242" />
    <SolidColorBrush x:Key="BtnDisabled" Color="#FF2A2A2A" />

</ResourceDictionary>
